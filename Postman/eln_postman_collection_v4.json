{
  "info": {
    "name": "ELN Backend - Tests bout en bout",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "password",
      "value": "motdepasse123"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "emailTech",
      "value": ""
    },
    {
      "key": "emailChercheur",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenChercheur",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "techId",
      "value": ""
    },
    {
      "key": "chercheurId",
      "value": ""
    },
    {
      "key": "echantillonId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Génère des données uniques au début de chaque run (1re requête)",
          "if (pm.info.requestName.startsWith('1 - ')) {",
          "  const id = Date.now();",
          "  pm.collectionVariables.set('runId', id);",
          "  pm.collectionVariables.set('emailTech', 'tech' + id + '@labo.fr');",
          "  pm.collectionVariables.set('emailChercheur', 'chercheur' + id + '@labo.fr');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0a - Inscription ADMIN fixe (ignorer si existe)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@labo.fr\", \"motDePasse\": \"{{password}}\", \"nom\": \"Admin Labo\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201 ou compte déjà existant', () => pm.expect([201, 400, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "0b - Connexion ADMIN (promu en SQL)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@labo.fr\", \"motDePasse\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set('tokenAdmin', d.token);",
              "pm.test('admin@labo.fr est ADMIN (UPDATE SQL fait ?)', () => pm.expect(d.role).to.eql('ADMIN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1 - Inscription TECHNICIEN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailTech}}\", \"motDePasse\": \"{{password}}\", \"nom\": \"Test Technicien\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set('token', d.token);",
              "pm.collectionVariables.set('techId', d.userId);",
              "pm.test('Rôle TECHNICIEN', () => pm.expect(d.role).to.eql('TECHNICIEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "1bis - SÉCURITÉ : inscription avec role=ADMIN ignoré",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailChercheur}}\", \"motDePasse\": \"{{password}}\", \"nom\": \"Test Chercheur\", \"role\": \"ADMIN\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 (role ignoré) ou 400', () => pm.expect([201, 400]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const d = pm.response.json();",
              "  pm.collectionVariables.set('chercheurId', d.userId);",
              "  pm.collectionVariables.set('tokenChercheur', d.token);",
              "  pm.test('Rôle forcé à TECHNICIEN', () => pm.expect(d.role).to.eql('TECHNICIEN'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1ter - TECHNICIEN ne peut pas changer de rôle",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/utilisateurs/{{techId}}/role",
        "body": {
          "mode": "raw",
          "raw": "{\"role\": \"ADMIN\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "1quater - ADMIN promeut le chercheur",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/utilisateurs/{{chercheurId}}/role",
        "body": {
          "mode": "raw",
          "raw": "{\"role\": \"CHERCHEUR\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "1quinquies - Connexion CHERCHEUR (nouveau rôle)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailChercheur}}\", \"motDePasse\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set('tokenChercheur', d.token);",
              "pm.test('Rôle CHERCHEUR', () => pm.expect(d.role).to.eql('CHERCHEUR'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Connexion correcte",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailTech}}\", \"motDePasse\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2bis - Connexion mauvais mot de passe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailTech}}\", \"motDePasse\": \"faux\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 401 ou 403', () => pm.expect([401, 403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Créer échantillon SANS token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/echantillons",
        "body": {
          "mode": "raw",
          "raw": "{\"reference\": \"NOPE-{{runId}}\", \"materiau\": \"SiC\", \"description\": \"ne doit pas passer\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 401 ou 403', () => pm.expect([401, 403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Créer échantillon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/echantillons",
        "body": {
          "mode": "raw",
          "raw": "{\"reference\": \"SIC-{{runId}}\", \"materiau\": \"SiC\", \"description\": \"Test découpe laser\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('echantillonId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5a - Ajouter une étape",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/echantillons/{{echantillonId}}/etapes",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"GRAVURE_PLASMA\", \"dateExecution\": \"2026-09-19T10:00:00\", \"pressionMbar\": 0.05, \"puissancePlasmaWatts\": 150, \"dureeMinutes\": 12}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "5b - Ajouter un résultat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/echantillons/{{echantillonId}}/resultats",
        "body": {
          "mode": "raw",
          "raw": "{\"type\": \"EPAISSEUR\", \"dateMesure\": \"2026-09-19T14:00:00\", \"valeur\": 250.5, \"unite\": \"nm\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Détail de l'échantillon",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/echantillons/{{echantillonId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('etapes[] non vide', () => pm.expect(d.etapes.length).to.be.at.least(1));",
              "pm.test('resultats[] non vide', () => pm.expect(d.resultats.length).to.be.at.least(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "7a - Mes échantillons (TECHNICIEN)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
